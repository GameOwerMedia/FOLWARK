{
  "name": "folwark-rts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/simulation.test.ts tests/assets.test.ts tests/development.test.ts tests/regime.test.ts tests/region.test.ts tests/i18n.test.ts tests/society.test.ts tests/seasons.test.ts tests/frontiers.test.ts",
    "assets": "node --import tsx scripts/prepare-sprites.ts",
    "portable": "npm run typecheck && node scripts/build-portable.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "easystarjs": "^0.4.4",
    "lucide": "^1.46.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.20",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
